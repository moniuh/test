# Skopiuj ten plik do .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Każda zmienna z .env trafia do wszystkich aplikacji.

# Klucz API Anthropic: włącza funkcje AI we wszystkich aplikacjach.
# Bez klucza aplikacje działają w trybie offline (reguły i heurystyki).
ANTHROPIC_API_KEY=

# 1 = wymuś tryb offline nawet z ustawionym kluczem.
HR_AI_OFFLINE=0

# Opcjonalnie: inny model niż domyślny ustawiony w kodzie aplikacji.
# Nie zostawiaj tej linii pustej: odkomentuj ją dopiero, gdy podajesz wartość.
# HR_AI_MODEL=

# Na jakim adresie nasłuchują porty.
#   127.0.0.1 = tylko ten komputer (zalecane: aplikacje nie mają logowania),
#   0.0.0.0   = dostęp z sieci lokalnej; wtedy ustaw też HR_PANEL_TOKEN poniżej.
BIND_ADDR=127.0.0.1

# Port portalu startowego. Aplikacje mają stałe porty 8001–8005.
PORTAL_PORT=8080

# Strefa czasowa (terminy szkoleń, daty w raportach i dziennikach).
TZ=Europe/Warsaw

# Asystent kadrowy: token chroniący panel HR (nagłówek X-HR-Token).
# Pusty lub zakomentowany = panel otwarty dla każdego, kto ma dostęp do portu.
# HR_PANEL_TOKEN=

# Repozytorium, z którego budowane są obrazy (np. własny fork).
# REPO_URL=https://github.com/moniuh/test.git
